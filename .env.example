# Copia este archivo a .env y ajusta los valores
# TOKEN que comparten frontend y bridge (elige uno aleatorio)
MERCURE_TOKEN=cambia-este-token-por-uno-largo-aleatorio
# Endpoint OpenAI-compatible del LLM (llama-server por defecto)
MERCURE_LLM_URL=http://localhost:8080/v1
MERCURE_LLM_MODEL=local-model
# URL de SearXNG (buscador privado)
SEARXNG_URL=http://127.0.0.1:8001/search
# Fallback a Gemini (opcional, solo si no hay LLM local)
# GOOGLE_API_KEY=
